.status {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.status-action {
  flex-shrink: 0;
  margin-left: auto;
  padding-left: 24rpx;
}
.status-title {
  font-size: 31rpx;
  font-weight: 720;
}
.statement {
  margin-top: 24rpx;
}
.version {
  display: block;
  margin-top: 22rpx;
  color: #8b9790;
  font-size: 22rpx;
}
.danger-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 34rpx 0;
}
