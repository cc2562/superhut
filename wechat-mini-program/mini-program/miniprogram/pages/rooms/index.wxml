<view class="page"
  ><view class="hero"
    ><text class="eyebrow">教务服务</text><text class="title">空教室</text
    ><text class="subtitle">选择日期、教学楼和节次，查询空闲教室。</text></view
  >
  <view class="card filters"
    ><view class="picker" bind:tap="openCalendar"><text>日期</text><text>{{date}} ›</text></view
    ><picker range="{{buildings}}" range-key="name" bindchange="onBuilding"
      ><view class="picker"
        ><text>教学楼</text><text>{{buildingName || '请选择'}} ›</text></view
      ></picker
    ><view class="picker-row"
      ><picker
        class="picker-half"
        range="{{lessonRange}}"
        value="{{startLesson - 1}}"
        bindchange="onStart"
        ><view class="picker"><text>起始节</text><text>第{{startLesson}}节 ›</text></view></picker
      ><picker
        class="picker-half"
        range="{{lessonRange}}"
        value="{{endLesson - 1}}"
        bindchange="onEnd"
        ><view class="picker"><text>结束节</text><text>第{{endLesson}}节 ›</text></view></picker
      ></view
    ><t-button block theme="primary" disabled="{{loading || !buildingId}}" bind:tap="search"
      >查询空教室</t-button
    ></view
  >
  <loading-state wx:if="{{loading}}" text="{{loadingText}}" />
  <block wx:else>
    <block wx:for="{{rooms}}" wx:key="id" wx:for-index="index">
      <view class="room card" data-index="{{index}}" bind:tap="toggle"
        ><view class="room-head"
          ><text class="room-name">{{item.name}}</text
          ><text class="room-seats">座位 {{item.seatNumber}}</text
          ><text class="arrow">{{item.expanded ? '▾' : '›'}}</text></view
        ><view class="slots" wx:if="{{item.expanded}}">
          <view
            class="slot {{slot.booked ? 'booked' : 'free'}}"
            wx:for="{{item.slots}}"
            wx:for-item="slot"
            wx:key="label"
            ><text>{{slot.label}}</text></view
          ><view class="legend"
            ><text class="legend-dot booked"></text><text>占用</text
            ><text class="legend-dot free"></text><text>空闲</text></view
          ></view
        ></view
      >
    </block>
    <t-empty wx:if="{{!rooms.length}}" description="选择条件后开始查询" />
  </block>
  <t-calendar
    visible="{{calendarVisible}}"
    value="{{calendarValue}}"
    min-date="{{calendarMinDate}}"
    max-date="{{calendarMaxDate}}"
    first-day-of-week="{{1}}"
    type="single"
    title="选择查询日期"
    confirm-btn="确定"
    switch-mode="year-month"
    bind:confirm="onCalendarConfirm"
    bind:close="onCalendarClose"
  />
</view>
