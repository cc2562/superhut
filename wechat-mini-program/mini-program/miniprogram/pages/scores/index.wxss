.picker-wrap {
  margin-bottom: 24rpx;
}
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  border: 1rpx solid #dce8e1;
  border-radius: 20rpx;
  background: #fff;
  font-size: 28rpx;
  font-weight: 600;
  color: #176b47;
}
.picker-arrow {
  color: #8ba097;
}
.summary {
  display: flex;
  align-items: stretch;
}
.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.summary-item + .summary-item {
  border-left: 1rpx solid #eef3f0;
}
.summary-value {
  color: #177049;
  font-size: 34rpx;
  font-weight: 750;
}
.summary-label {
  color: #718078;
  font-size: 22rpx;
}
.score {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.score view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.score-name {
  font-size: 29rpx;
  font-weight: 700;
}
.score-value {
  color: #177049;
  font-size: 42rpx;
  font-weight: 760;
}
