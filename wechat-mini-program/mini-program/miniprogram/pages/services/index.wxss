.notice-card {
  padding: 30rpx;
}
.notice-head,
.notice-heading,
.notice-title-row,
.notice-state {
  display: flex;
  align-items: center;
}
.notice-head {
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.notice-heading {
  gap: 18rpx;
}
.notice-icon {
  display: grid;
  place-items: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  color: #176b47;
  background: #e0f3e7;
  font-size: 26rpx;
  font-weight: 750;
}
.notice-label,
.notice-count,
.notice-title,
.notice-summary {
  display: block;
}
.notice-label {
  font-size: 30rpx;
  font-weight: 720;
}
.notice-count {
  margin-top: 4rpx;
  color: #287b57;
  font-size: 22rpx;
}
.notice-all {
  color: #287b57;
  font-size: 24rpx;
}
.notice-copy {
  min-height: 88rpx;
}
.notice-title-row {
  gap: 12rpx;
}
.unread-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #dc4c3f;
}
.notice-title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.notice-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #718078;
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.notice-state {
  min-height: 88rpx;
  justify-content: center;
  gap: 16rpx;
}
.service {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
}
.icon {
  display: grid;
  place-items: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  color: #246747;
  background: #e0f3e7;
  font-size: 30rpx;
  font-weight: 750;
}
.blue .icon {
  color: #38658c;
  background: #e3eff9;
}
.purple .icon {
  color: #705f9f;
  background: #eee9f8;
}
.orange .icon {
  color: #9a6426;
  background: #f9ead9;
}
.copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}
.service-title {
  font-size: 31rpx;
  font-weight: 720;
}
.arrow {
  color: #8ba097;
  font-size: 48rpx;
}
