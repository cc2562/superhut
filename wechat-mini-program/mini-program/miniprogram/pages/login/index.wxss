.form {
  padding: 8rpx 20rpx 24rpx;
  overflow: hidden;
}
.remember {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 12rpx 8rpx;
}
.remember-copy {
  flex: 1;
}
.remember-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 650;
}
.footnote {
  display: block;
  margin-top: 30rpx;
  color: #8a958f;
  text-align: center;
  font-size: 23rpx;
}
.stage0 {
  margin-top: 28rpx;
}
.stage0-title,
.stage0-message,
.request-id {
  display: block;
}
.stage0-title {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.stage0 t-button {
  display: block;
  margin-top: 24rpx;
}
.stage0-result {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #eef5f1;
}
.stage0-result.passed {
  color: #176b47;
  background: #e5f4eb;
}
.stage0-result.failed {
  color: #963b32;
  background: #fbecea;
}
.stage0-message {
  font-size: 25rpx;
  line-height: 1.6;
}
.request-id {
  margin-top: 8rpx;
  color: #718078;
  font-size: 21rpx;
  word-break: break-all;
}
.result-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(23, 107, 71, 0.14);
  font-size: 24rpx;
}
