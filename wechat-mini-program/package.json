{
  "name": "superhut-workspace",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @superhut/api-contract build && pnpm --filter @superhut/domain-rules build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check \"{mini-program,server,packages}/**/*.{ts,json,md,yml,yaml,wxss,wxml}\" \"*.{json,yml,yaml,md,mjs}\"",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter @superhut/server db:check && pnpm test && pnpm build",
    "cloud:services": "wxcloud service:list --envId prod-d2gm96mrjfb4565b0 --json",
    "cloud:deploy": "wxcloud run:deploy . --targetDir=. --dockerfile=Dockerfile --containerPort=3000 --envId=prod-d2gm96mrjfb4565b0 --serviceName=superhut-api --releaseType=FULL --remark=superhut-api --noConfirm"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
